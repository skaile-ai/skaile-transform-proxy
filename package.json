{
  "name": "@skaile/transform-proxy",
  "version": "0.4.0",
  "type": "module",
  "description": "Same-protocol passthrough proxy that runs model requests and replies through a chain of text transforms (Anthropic Messages, OpenAI chat, OpenAI responses)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaile-ai/skaile-transform-proxy.git"
  },
  "homepage": "https://github.com/skaile-ai/skaile-transform-proxy#readme",
  "bugs": {
    "url": "https://github.com/skaile-ai/skaile-transform-proxy/issues"
  },
  "keywords": [
    "llm",
    "proxy",
    "anthropic",
    "openai",
    "anonymization",
    "transform"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./omp": {
      "types": "./dist/omp/index.d.mts",
      "import": "./dist/omp/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "omp": {
    "extensions": [
      "./dist/omp/index.mjs"
    ]
  },
  "bin": {
    "skaile-transform-proxy": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsdown",
    "prepare": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  }
}
